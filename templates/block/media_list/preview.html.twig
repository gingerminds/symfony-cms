{#
 # Admin preview of the `media_list` block: `block`, `data`, `refs`, `uid`.
 #}
<div class="gm-cms-block-preview-media-list">
    {% if data.title %}<h3 class="h5 mb-2">{{ data.title }}</h3>{% endif %}
    {% if data.items %}
        <ul class="list-unstyled mb-0">
            {% for item in data.items %}
                <li class="mb-2">
                    {{ include('@GingermindsCms/block/_media.html.twig', {media: refs.items[loop.index0].media ?? null, missing: item.media is not empty}, with_context = false) }}
                    {% if item.subtitle %}<div class="small text-muted">{{ item.subtitle }}</div>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    {% if not data.title and not data.items %}{{ include('@GingermindsCms/block/_empty.html.twig') }}{% endif %}
</div>
