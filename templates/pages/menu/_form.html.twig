{% trans_default_domain 'GingermindsCms' %}
{{ form_errors(form) }}
{% embed '@GingermindsCore/crud/_form_layout.html.twig' %}
    {% trans_default_domain 'GingermindsCms' %}

    {% block main %}
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h5 class="card-title mb-0"><i class="bi bi-menu-button-wide me-1 text-primary"></i> {{ 'menu.name_s'|trans }}</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    {{ form_row(form.code) }}
                </div>
            </div>
        </div>
    {% endblock %}
{% endembed %}
