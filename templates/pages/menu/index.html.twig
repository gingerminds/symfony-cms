{% extends '@GingermindsCore/crud/list.html.twig' %}
{% trans_default_domain 'GingermindsCms' %}

{% set columns = [
    {label: '#', align: 'center'},
    {label: 'menu.field.code', property: 'code', sortable: true},
    {label: 'common.actions', align: 'end', translation_domain: 'GingermindsCore'},
] %}

{% block table_empty_icon %}bi-menu-button-wide{% endblock %}

{% block table_row %}
    <td class="text-center text-muted small">{{ row_number }}</td>
    <td>
        {% if is_granted('EDIT', item) %}
            <a href="{{ path(resource.route('edit'), {id: item.id}) }}" class="text-body fw-medium">{{ item.code }}</a>
        {% else %}
            <span class="fw-medium">{{ item.code }}</span>
        {% endif %}
    </td>
    <td class="text-end">
        <div class="d-inline-flex gap-1 align-items-center">
            {% if is_granted('VIEW', 'menu_item') %}
                <a href="{{ path(gm_resource('menu_item').route('index'), {menuId: item.id}) }}" class="btn btn-sm btn-outline-success fs-12">
                    <i class="bi bi-list-nested me-1"></i> {{ 'menu_item.name_p'|trans }}
                </a>
            {% endif %}
            {{ block('row_actions') }}
        </div>
    </td>
{% endblock %}
