{#
 # Menu item form: General tab (core form layout, `menu_item_form_main|sidebar` form includes)
 # and Translations tab (language tabs). A tab with errors is red, the first invalid one is open.
 #}
{% trans_default_domain 'GingermindsCms' %}
{% set general_valid = form.children|filter((child, name) => name != 'translations' and not child.vars.valid) is empty %}
{% set tabs = [
    {id: 'general', label: 'menu_item.tab.general'|trans, valid: general_valid},
    {id: 'translations', label: 'menu_item.tab.translations'|trans, valid: form.translations.vars.valid},
] %}
{% set active = general_valid and not form.translations.vars.valid ? 'translations' : 'general' %}

{{ form_errors(form) }}

<nav class="mb-3">
    <div class="nav nav-tabs" role="tablist">
        {% for tab in tabs %}
            <button type="button" class="nav-link{{ tab.id == active ? ' active' }}{{ tab.valid ? '' : ' text-danger' }}"
                    id="menu-item-tab-{{ tab.id }}" data-bs-toggle="tab" data-bs-target="#menu-item-pane-{{ tab.id }}"
                    role="tab" aria-controls="menu-item-pane-{{ tab.id }}" aria-selected="{{ tab.id == active ? 'true' : 'false' }}">
                {{- tab.label -}}
                {%- if not tab.valid %} <i class="bi bi-exclamation-circle" aria-hidden="true"></i>{% endif -%}
            </button>
        {% endfor %}
    </div>
</nav>

<div class="tab-content">
    <div class="tab-pane fade{{ active == 'general' ? ' show active' }}" id="menu-item-pane-general"
         role="tabpanel" aria-labelledby="menu-item-tab-general">
        {% embed '@GingermindsCore/crud/_form_layout.html.twig' %}
            {% trans_default_domain 'GingermindsCms' %}

            {% block main %}
                <div class="card shadow-sm mb-4">
                    <div class="card-header py-3">
                        <h5 class="card-title mb-0"><i class="bi bi-link-45deg me-1 text-primary"></i> {{ 'menu_item.name_s'|trans }}</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            {{ form_row(form.code) }}
                        </div>
                    </div>
                </div>
            {% endblock %}

            {% block sidebar %}
                <div class="card shadow-sm mb-4">
                    <div class="card-header py-3">
                        <h5 class="card-title mb-0"><i class="bi bi-diagram-3 me-1 text-primary"></i> {{ 'menu_item.form.position'|trans }}</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            {{ form_row(form.active) }}
                            {{ form_row(form.parent) }}
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header py-3">
                        <h5 class="card-title mb-0"><i class="bi bi-box-arrow-up-right me-1 text-primary"></i> {{ 'menu_item.form.link'|trans }}</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            {{ form_row(form.targetBlank) }}
                            {{ form_row(form.noReferrer) }}
                            {{ form_row(form.noOpener) }}
                            {{ form_row(form.noFollow) }}
                        </div>
                    </div>
                </div>
            {% endblock %}
        {% endembed %}
    </div>

    <div class="tab-pane fade{{ active == 'translations' ? ' show active' }}" id="menu-item-pane-translations"
         role="tabpanel" aria-labelledby="menu-item-tab-translations">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                {{ form_widget(form.translations) }}
                {{ form_errors(form.translations) }}
            </div>
        </div>
    </div>
</div>
