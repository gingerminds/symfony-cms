{% extends '@GingermindsCore/crud/list_tree.html.twig' %}
{% trans_default_domain 'GingermindsCms' %}

{% set tree_reorder_url = is_granted('EDIT', resource.name) ? path('gingerminds_cms_page_category_reorder') : null %}
{% set tree_csrf_token_id = reorder_csrf_token_id %}

{% block list_filters %}{% endblock %}

{% block tree %}
    {% if roots is empty %}
        <div class="text-center text-muted py-5">
            <i class="bi bi-diagram-3 fs-1 d-block mb-2 opacity-25"></i>
            {{ 'page_category.message.no_items'|trans }}
        </div>
    {% else %}
        {% include '@GingermindsCms/pages/page_category/_tree.html.twig' with {tree_items: roots, parent_id: null, depth: 0} %}
    {% endif %}
{% endblock %}
